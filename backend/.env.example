# ---------- core ----------
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://arena:arena@localhost:5432/arena
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ADMIN_TOKEN=change-me-to-a-long-random-admin-token
CORS_ORIGIN=https://your-miniapp-domain.com
WEBAPP_URL=https://your-miniapp-domain.com

# ---------- telegram ----------
BOT_TOKEN=123456:telegram-bot-token-from-botfather
ADMIN_CHAT_ID=
# local testing only (never in production): allows POST /auth/dev
DEV_LOGIN=false

# ---------- TON ----------
TON_NETWORK=mainnet
TONCENTER_API_KEY=
# PUBLIC address of the wallet that receives deposits AND pays withdrawals
HOT_WALLET_ADDRESS=
# 24 words, ONLY on the worker server, never commit, never share
HOT_WALLET_MNEMONIC=
HOT_WALLET_VERSION=v5
# MINE jetton master contract address and its decimals
MINE_JETTON_MASTER=
MINE_DECIMALS=9

# ---------- mining economy ----------
BLOCK_SECONDS=600
HALVING_BLOCKS=210240
# MINE reserved for mining rewards (must really be inside the hot wallet)
MINING_POOL_TOTAL=0
CLAIM_MIN=0.001

# ---------- store / market ----------
STORE_MINE_BURN_PCT=50
# 500 = 5%, paid by the seller (half burned, half to treasury, see MARKET_FEE_BURN_PCT)
MARKET_FEE_BPS=100
MARKET_FEE_BURN_PCT=50
MARKET_MIN_PRICE=1
MARKET_MAX_PRICE=1000000
MARKET_MAX_LISTINGS=20
MAX_MINERS_PER_USER=200

# ---------- deposits / withdrawals ----------
DEPOSIT_MIN_TON=0.1
DEPOSIT_MIN_MINE=1
DEPOSIT_CONFIRM_SECONDS=20
WITHDRAW_MIN=100
WITHDRAW_AUTO_LIMIT=500
# flat fee in MINE per withdrawal, charged on top of the amount the user receives
WITHDRAW_FEE=70
WITHDRAW_MIN_ACCOUNT_AGE_HOURS=24
WITHDRAW_GLOBAL_DAILY_CAP=50000
WITHDRAW_GAS_TON=0.06

# ---------- tasks ----------
# your support channel (the bot MUST be an admin of it so it can check who joined)
SUPPORT_CHANNEL=@miningarenaofficial
CHANNEL_TASK_REWARD=20
# MINE reserved for task rewards (must really be inside the hot wallet)
TASK_POOL_TOTAL=0
LINK_TASK_MIN_SECONDS=15

# ---------- sponsored tasks (users promote their own channel) ----------
USER_TASK_COST_PER_JOIN=50
# what each new member receives; the difference (50-35) is the platform fee. Set 50 for no fee.
USER_TASK_JOINER_REWARD=35
USER_TASK_MIN_BUDGET=100
USER_TASK_MAX_BUDGET=1000
USER_TASK_MAX_ACTIVE=3
# false = you review each new promotion first (recommended)
USER_TASK_AUTO_APPROVE=false
